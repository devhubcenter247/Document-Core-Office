<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- The OCR model comes from Google Play services: download it when the app is installed. An
             app that needs other ML Kit models lists them all here with tools:replace="android:value". -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />
        <!-- The SDK's ready-made viewer screen (com.editor.docsdk.DocumentViewer). -->
        <activity
            android:name="com.editor.docsdk.DocumentViewerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
    </application>

</manifest>
